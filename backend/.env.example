# Copy to .env and fill in values. Never commit .env.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/taskpilot
JWT_SECRET=replace-with-64-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
FRONTEND_ORIGIN=http://localhost:3000
GROQ_API_KEY=gsk_replace_me
# Pick a current model from Groq's model list
AI_MODEL=
AI_DAILY_LIMIT_PER_USER=50
INTAKE_SECRET=replace-with-random-string
CRON_SECRET=replace-with-random-string
APP_TIMEZONE=Asia/Manila
